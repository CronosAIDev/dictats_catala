PORT=3003
NODE_ENV=development
SESSION_SECRET=canvia-aixo-per-un-secret-llarg-i-aleatori

ANTHROPIC_API_KEY=sk-ant-...

# Identitat (Firebase / Identity Platform).
#
# La clau NO es cap secret: va al frontend per disseny i el que la protegeix es
# la llista de dominis autoritzats de Firebase, no amagar-la.
#
# A produccio les dues son OBLIGATORIES: sense elles el servidor es nega a
# arrencar, perque sense la clau ningu podria entrar i la pantalla es veuria
# perfecta.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=kairos-family-app

# Opcional: ruta absoluta de la BD SQLite.
# Si no es defineix, s'usa <repo>/data/dictats.db
# A producció: /var/dictats/data/dictats.db
# DICTATS_DB_PATH=

# Salta el login en local per poder mirar l'app sense donar-se d'alta a
# Firebase. NOMES desenvolupament: amb NODE_ENV=production el servidor es nega
# a arrencar.
# DICTATS_AUTH_BYPASS=1

# Model de Claude per a la correcció. Per defecte, claude-opus-4-6.
# Des de v6 la comparació de textos es fa al servidor i al model només li queda
# escriure les explicacions, feina que cabria en un model més petit i barat.
# DICTATS_MODEL=claude-opus-4-6
