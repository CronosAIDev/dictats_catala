PORT=3003
NODE_ENV=development
SESSION_SECRET=canvia-aixo-per-un-secret-llarg-i-aleatori

ANTHROPIC_API_KEY=sk-ant-...

# ── Identitat pròpia de Dictats (Fase 0, Issue #16) ──────────
# Usuaris i sessions. Base `cronosai` a db1.bwai.cc, la mateixa que
# `aicamper_app`, amb totes les taules sota el prefix `dictats_`.
#
# Ja NO és `BrandWaiUserProfile`: aquella és la taula de clients de Trawlingweb,
# amb les contrasenyes en text pla, i Dictats se n'ha desacoblat. Les d'aquí van
# amb bcrypt.
#
# NO facis servir root: crea un usuari dedicat amb permisos només sobre aquesta
# base. Les taules es creen amb `scripts/db/001_usuaris.sql`.
DB_HOST=db1.bwai.cc
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cronosai

# ── Entrar amb Google (OAuth 2.0) — OPCIONAL ─────────────────
# Sense les tres, el login per contrasenya funciona igual i el botó de Google no
# apareix. NO calen per arrencar el servidor.
#
# Surten del projecte GCP `kairos-family-app`:
#   APIs i serveis -> Credencials -> Crear credencials -> ID de client d'OAuth
#   -> Tipus "Aplicació web".
#
# El REDIRECT_URI ha de coincidir EXACTAMENT amb un dels URI de redirecció
# autoritzats de la credencial. En local:
#   http://localhost:3003/auth/google/callback
# A producció:
#   https://dictation.generaive.io/auth/google/callback
#
# Amb Google, els 20 testers docents que Play demana entren amb el seu compte:
# ni cal crear-los comptes ni administrar contrasenyes de ningú.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Opcional: ruta absoluta de la BD SQLite.
# Si no es defineix, s'usa <repo>/data/dictats.db
# A producció: /var/dictats/data/dictats.db
# DICTATS_DB_PATH=

# Salta el login en local quan no hi ha credencials de base de dades. NOMES
# desenvolupament:
# amb NODE_ENV=production el servidor es nega a arrencar.
# DICTATS_AUTH_BYPASS=1

# Model de Claude per a la correcció. Per defecte, claude-opus-4-6.
# Des de v6 la comparació de textos es fa al servidor i al model només li queda
# escriure les explicacions, feina que cabria en un model més petit i barat.
# DICTATS_MODEL=claude-opus-4-6
